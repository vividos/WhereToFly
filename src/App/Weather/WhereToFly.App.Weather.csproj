<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DotNetVersion)-android;$(DotNetVersion)-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>WhereToFly.App.Weather</RootNamespace>
    <UseMaui>true</UseMaui>
    <IsPackable>false</IsPackable>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Where-to-fly Weather</ApplicationTitle>
    <ApplicationDisplayVersion>$(AssemblyInformationalVersion)</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F299E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F299E" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(DotNetMicrosoftPackagesVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(DotNetMauiVersion)" />
  </ItemGroup>

  <!-- .NET Windows properties -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationId>de.vividos.app.wheretofly.weather.windows</ApplicationId>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!-- .NET Windows release properties -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And '$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContailed>true</SelfContailed>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- .NET Android properties -->
  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <ApplicationId>de.vividos.app.wheretofly.weather.android</ApplicationId>
    <SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
    <!-- Disable automatically setting version numbers on MAUI -->
    <NBGV_SetMauiVersionProperties>false</NBGV_SetMauiVersionProperties>
  </PropertyGroup>

  <!-- .NET Android debug properties -->
  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(Configuration)' == 'Debug' ">
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- .NET Android versionCode -->
  <PropertyGroup>
    <BeforeGenerateAndroidManifest>$(BeforeGenerateAndroidManifest);SetAndroidVersionCode</BeforeGenerateAndroidManifest>
  </PropertyGroup>

  <Target Name="SetAndroidVersionCode" DependsOnTargets="GetBuildVersion" Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <PropertyGroup>
      <!-- Set versionCode to MmmHHH, with M = major version, mm = minor version, HHH = git height -->
      <ApplicationVersion>$([System.String]::Format('{0}{1:D2}{2:D3}',
          $([System.Version]::Parse($(BuildVersionSimple)).Major),
          $([System.Version]::Parse($(BuildVersionSimple)).Minor),
          $([System.Int32]::Parse($(GitVersionHeight)))
        ))</ApplicationVersion>
    </PropertyGroup>
    <Message Importance="High" Text="Setting android:versionCode to $(ApplicationVersion)" />
  </Target>

</Project>
