<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WhereToFly.App.ViewModels"
             x:Class="WhereToFly.App.Pages.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings">

    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>

        <ScrollView Orientation="Vertical" HorizontalOptions="Center">

            <!-- Grid with all settings -->
            <Grid ColumnDefinitions="1*"
                  RowDefinitions="Auto, Auto"
                  WidthRequest="350"
                  MaximumWidthRequest="450"
                  HorizontalOptions="Center"
                  VerticalOptions="Fill"
                  Padding="8">

                <!-- App theme picker -->
                <Grid RowDefinitions="Auto, Auto"
                      RowSpacing="8">
                    <Label Grid.Row="0"
                           Style="{StaticResource CardLabelStyle}"
                           Text="App theme" />
                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}">
                        <Picker
                            ItemsSource="{Binding AppThemeItems}"
                            ItemDisplayBinding="{Binding Text, x:DataType=viewmodels:SettingsViewModel+AppThemeViewModel}"
                            SelectedItem="{Binding SelectedAppTheme}"
                            Margin="8" />
                    </Border>
                </Grid>

                <!-- Map settings controls -->
                <Grid RowDefinitions="Auto, Auto"
                      RowSpacing="8"
                      Grid.Row="1">
                    <Label Grid.Row="0"
                           Style="{StaticResource CardLabelStyle}"
                           Text="Map settings" />
                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}">

                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                              ColumnDefinitions="1*, 1*"
                              VerticalOptions="Fill"
                              ColumnSpacing="16"
                              RowSpacing="16"
                              Padding="8">

                            <!-- Base layer -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   FontSize="Small"
                                   VerticalOptions="Center"
                                   Text="Base layer" />
                            <Picker Grid.Row="0" Grid.Column="1"
                                    ItemsSource="{Binding MapImageryTypeItems}"
                                    ItemDisplayBinding="{Binding Text, x:DataType=viewmodels:SettingsViewModel+MapImageryTypeViewModel}"
                                    SelectedItem="{Binding SelectedMapImageryType}" />

                            <!-- Map overlay type -->
                            <Label Grid.Row="1" Grid.Column="0"
                                   FontSize="Small"
                                   VerticalOptions="Center"
                                   Text="Overlay" />
                            <Picker Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding MapOverlayTypeItems}"
                                    ItemDisplayBinding="{Binding Text, x:DataType=viewmodels:SettingsViewModel+MapOverlayTypeViewModel}"
                                    SelectedItem="{Binding SelectedMapOverlayType}" />

                            <!-- Map shading mode -->
                            <Label Grid.Row="2" Grid.Column="0"
                                   FontSize="Small"
                                   VerticalOptions="Center"
                                   Text="Map shading" />
                            <Picker Grid.Row="2" Grid.Column="1"
                                    ItemsSource="{Binding MapShadingModeItems}"
                                    ItemDisplayBinding="{Binding Text, x:DataType=viewmodels:SettingsViewModel+MapShadingModeViewModel}"
                                    SelectedItem="{Binding SelectedMapShadingModeItem}" />

                            <!-- Lat/long coordinates display format -->
                            <Label Grid.Row="3" Grid.Column="0"
                                   FontSize="Small"
                                   VerticalOptions="Center"
                                   Text="Coordinates format" />
                            <Picker Grid.Row="3" Grid.Column="1"
                                    ItemsSource="{Binding CoordinateDisplayFormatItems}"
                                    ItemDisplayBinding="{Binding Text, x:DataType=viewmodels:SettingsViewModel+CoordinateDisplayFormatViewModel}"
                                    SelectedItem="{Binding SelectedCoordinateDisplayFormatItem}" />

                            <!-- Map entity clustering -->
                            <Label Grid.Row="4" Grid.Column="0"
                                   FontSize="Small"
                                   VerticalOptions="Center"
                                   Text="Use location clustering" />
                            <Switch Grid.Row="4" Grid.Column="1"
                                    IsToggled="{Binding MapEntityClustering}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </ScrollView>

    </ContentPage.Content>
</ContentPage>
