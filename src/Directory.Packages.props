<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <DotNetMauiVersion>11.0.10</DotNetMauiVersion>
    <DotNetMicrosoftPackagesVersion>11.0.0</DotNetMicrosoftPackagesVersion>
  </PropertyGroup>

  <!-- Common packages -->
  <ItemGroup>
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetMicrosoftPackagesVersion)" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="Sandwych.QuickGraph.Core" Version="1.0.0" />
    <PackageVersion Include="SharpKml.Core" Version="6.1.0" />
    <PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>

  <!-- App packages -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.AppCenter.Crashes" Version="5.0.7" GeneratePathProperty="true" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(DotNetMicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(DotNetMauiVersion)" />
    <PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="4.156.0" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="Xamarin.AndroidX.WebKit" Version="1.15.0" />
  </ItemGroup>

  <!-- Unit test packages-->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Mocks.Maui" Version="1.2.5" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <!-- UI test packages-->
  <ItemGroup>
    <PackageVersion Include="Appium.WebDriver" Version="5.0.0" />
    <PackageVersion Include="Plugin.Maui.UITestHelpers.Appium" Version="1.0.0-preview5" />
    <PackageVersion Include="Plugin.Maui.UITestHelpers.Core" Version="1.0.0-preview5" />
    <PackageVersion Include="Plugin.Maui.UITestHelpers.NUnit" Version="1.0.0-preview5" />
  </ItemGroup>

  <!-- Web project packages-->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetMicrosoftPackagesVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetMicrosoftPackagesVersion)" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.0" />
  </ItemGroup>

  <!-- Analysis & Build packages -->
  <ItemGroup>
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.*" />
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.109-beta" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
  </ItemGroup>
</Project>
